# Database — SQLite for local, PostgreSQL for production
# Local:
DATABASE_URL="file:./dev.db"
# Production (also change prisma/schema.prisma provider to "postgresql"):
# DATABASE_URL="postgresql://user:password@localhost:5432/devicelab?schema=public"

NEXT_PUBLIC_APP_NAME="DeviceLab"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage
SCREENSHOT_DIR="./storage/screenshots"

# Security / limits
MAX_UPLOAD_BYTES=2097152
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
PLAYWRIGHT_TIMEOUT_MS=30000
JOB_CONCURRENCY=2
